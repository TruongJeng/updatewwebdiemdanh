RewriteEngine On

# 1. Chuyển hướng các URL đang có đuôi .php sang URL không có đuôi .php
# (Giúp SEO tốt hơn và đồng bộ URL khi người dùng vô tình truy cập link cũ có .php)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Xử lý các request không có đuôi .php (tìm và chạy file .php tương ứng)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
