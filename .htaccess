Options -Indexes

# Error pages
ErrorDocument 403 /hethongdiemdanh/403.php
ErrorDocument 404 /hethongdiemdanh/404.php

RewriteEngine On

# Redirect direct directory access to login page
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/hethongdiemdanh/?$
RewriteRule ^(.*)$ /hethongdiemdanh/index [R=302,L]

# Clean URLs - hide .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Redirect .php URLs to clean URLs (SEO) - Only for GET requests
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
